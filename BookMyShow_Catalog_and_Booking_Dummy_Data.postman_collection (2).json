    {
      "name": "Booking Service - Dummy Data and Flow",
      "item": [
        {
          "name": "15 - Initialize Booking Seats for Show 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/shows/{{show1Id}}/seats",
              "host": [
                "{{bookingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shows",
                "{{show1Id}}",
                "seats"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seatNumbers\": [\n    \"A1\",\n    \"A2\",\n    \"A3\",\n    \"A4\",\n    \"A5\",\n    \"B1\",\n    \"B2\",\n    \"B3\",\n    \"B4\",\n    \"B5\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Seats initialized successfully\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "16 - List Available Seats for Show 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{bookingBaseUrl}}/api/v1/shows/{{show1Id}}/seats?status=AVAILABLE&page=0&size=20",
              "host": [
                "{{bookingBaseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "shows",
                "{{show1Id}}",
                "seats"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Available seats returned\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const seats = Array.isArray(r) ? r : (r.content || []);",
                  "if (seats.length >= 2) {",
                  "  pm.collectionVariables.set(\"bookingSeat1Id\", seats[0].id);",
                  "  pm.collectionVariables.set(\"bookingSeat2Id\", seats[1].id);",
                  "  console.log(\"bookingSeat1Id:\", seats[0].id);",
                  "  console.log(\"bookingSeat2Id:\", seats[1].id);",
                  "}"
                ]
              }
            }
          ]
        },
